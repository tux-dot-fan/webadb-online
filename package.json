{
  "name": "webadb-online",
  "version": "0.1.0",
  "private": true,
  "description": "WebADB - run ADB fully in your browser. Live at webadb.online.",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "tsx scripts/build-info.ts",
    "blog:build": "hexo generate --cwd blog",
    "blog:clean": "rm -rf public/blog",
    "build": "npm run blog:clean && npm run blog:build && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@yume-chan/adb": "^3.0.0-beta.1",
    "@yume-chan/adb-credential-web": "^3.0.0-beta.1",
    "@yume-chan/adb-daemon-webusb": "^3.0.0-beta.1",
    "@yume-chan/stream-extra": "^3.0.0-beta.1",
    "mp4-muxer": "^5.1.5",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/w3c-web-usb": "^1.0.10",
    "hexo": "^8.1.2",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.3.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-theme-landscape": "^1.1.0",
    "tsx": "^4.23.7",
    "typescript": "^5.6.0"
  }
}
